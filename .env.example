# ==============================================================================
# GoAffPro Store Hunter & CRM - Environment Configuration Example
# ==============================================================================
# Copy this file to .env if you need to customize default settings.
# Default configurations work out of the box without any modification.

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
DEBUG=false

# Frontend Dashboard Configuration
FRONTEND_PORT=5174

# Database Path (defaults to data/goaffpro.db)
DB_PATH=data/goaffpro.db

# Scraping & Network Settings
# Set to true only if you have ExpressVPN CLI installed and configured
ENABLE_VPN=false

# Google Trends Session Settings
TRENDS_COOLDOWN_BASE=18.0
TRENDS_MAX_COOLDOWN=120.0

# Traffic.cv Scraping Settings
TRAFFIC_CV_AUTO_FALLBACK_TIMEOUT=90
